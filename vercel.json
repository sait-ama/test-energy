{
  "rewrites": [
    {
      "source": "/raffle",
      "destination": "/raffle/index.html"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/proxy.js"
    },
    {
      "source": "/duck",
      "destination": "/api/proxy.js"
    },
    {
      "source": "/",
      "destination": "/index.html"
    }
  ]
}
