{
  "redirects": [
    { "source": "/raffle", "destination": "/", "permanent": false }
  ],
  "rewrites": [
    {
      "source": "/raffle-api/:action",
      "destination": "/api/raffle?operation=:action"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/proxy.js"
    },
    {
      "source": "/duck",
      "destination": "/api/proxy.js"
    },
    {
      "source": "/duck-event",
      "destination": "/index.html"
    },
    {
      "source": "/",
      "destination": "/raffle/index.html"
    }
  ]
}
